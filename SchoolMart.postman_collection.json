        {
          "name": "Get Uniform Details",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{authToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/uniforms/{{uniformId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "uniforms", "{{uniformId}}"]
            }
          },
          "response": []
