# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=school_mart
DB_USER=postgres
DB_PASSWORD=your_db_password

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRY=8h

# Frontend URL (for building tracking links)
FRONTEND_URL=http://localhost:5173

# Email (Resend API)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=no-reply@schoolmart.com
